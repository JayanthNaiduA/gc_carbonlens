rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'phoneNumber', 'wallet', 'consent', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 30));
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid;
      allow delete: if false;

      // Planting Plots Subcollection
      match /plots/{plotId} {
        allow get: if isOwner(userId) && isValidId(plotId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(plotId) &&
                         incoming().project_id is string &&
                         incoming().claimed_count is number &&
                         incoming().species is string;
        allow update: if isOwner(userId) && isValidId(plotId);
        allow delete: if false;
      }

      // Recycling Claims Subcollection
      match /claims/{claimId} {
        allow get: if isOwner(userId) && isValidId(claimId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(claimId) &&
                         incoming().claim_id is string &&
                         incoming().item_category is string &&
                         incoming().weight_kg is number;
        allow update: if isOwner(userId) && isValidId(claimId);
        allow delete: if false;
      }

      // Green Points Ledger Subcollection
      match /ledger/{ledgerId} {
        allow get: if isOwner(userId) && isValidId(ledgerId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(ledgerId) &&
                         incoming().event_id is string &&
                         incoming().points_delta is number;
        allow update, delete: if false;
      }

      // Verified Green Orders & Automatic Credits Subcollection
      match /orders/{orderId} {
        allow get: if isOwner(userId) && isValidId(orderId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(orderId) &&
                         incoming().order_id is string &&
                         incoming().credits_earned is number;
        allow update, delete: if false;
      }
    }
  }
}
